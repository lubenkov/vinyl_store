{
    "name": "vinyl-store",
    "version": "1.0.0",
    "description": "Backend API for a vinyl records store built with NestJS, TypeScript, MySQL and Stripe",
    "author": "lubenkov",
    "license": "MIT",
    "main": "dist/main.js",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/lubenkov/vinyl_store.git"
    },
    "keywords": [
        "nestjs",
        "typescript",
        "vinyl",
        "records",
        "store",
        "api",
        "sequelize",
        "stripe",
        "swagger"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "nest build",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main.js",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "prepare": "husky",
        "db:migrate": "sequelize-cli db:migrate",
        "db:migrate:undo": "sequelize-cli db:migrate:undo",
        "db:seed": "sequelize-cli db:seed:all",
        "db:seed:undo": "sequelize-cli db:seed:undo:all"
    },
    "lint-staged": {
        "*.{js,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "devDependencies": {
        "@nestjs/cli": "^10.4.6",
        "@nestjs/testing": "^10.4.6",
        "@types/bcryptjs": "^2.4.6",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.8.4",
        "@types/nodemailer": "^6.4.16",
        "@types/passport-google-oauth20": "^2.0.16",
        "@types/supertest": "^6.0.2",
        "@typescript-eslint/eslint-plugin": "^8.12.2",
        "@typescript-eslint/parser": "^8.12.2",
        "dotenv": "^16.4.5",
        "eslint": "^9.13.0",
        "husky": "^9.1.6",
        "jest": "^29.7.0",
        "lint-staged": "^15.2.10",
        "prettier": "^3.3.3",
        "sequelize-cli": "^6.6.2",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.12.2"
    },
    "dependencies": {
        "@nestjs/axios": "^3.1.2",
        "@nestjs/config": "^3.3.0",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^10.4.6",
        "@nestjs/sequelize": "^10.0.1",
        "@nestjs/swagger": "^8.0.1",
        "bcryptjs": "^2.4.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "joi": "^17.13.3",
        "mysql2": "^3.11.3",
        "nodemailer": "^6.9.16",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "sequelize": "^6.37.5",
        "sequelize-typescript": "^2.1.6",
        "stripe": "^17.3.1",
        "swagger-ui-express": "^5.0.1",
        "winston": "^3.15.0"
    }
}