PORT=3000

DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=your_database_password
DATABASE_NAME=vinyl_store
# Set to true for TiDB Cloud / any MySQL that requires TLS.
DATABASE_SSL=false
# Keep the pool small on serverless (Vercel).
DATABASE_POOL_MAX=5

# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_string

# sk_test_dummy* enables the demo purchase flow without calling Stripe.
STRIPE_SECRET_KEY=sk_test_dummy

EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password

GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# The backend mounts all routes under /api.
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Where to return the user after Google OAuth (frontend origin).
FRONTEND_URL=http://localhost:5173
# Comma-separated extra origins, wildcards are supported (e.g. https://*.vercel.app).
# A bare * is allowed only outside production; in production set explicit origins.
CORS_ORIGINS=
# Swagger is disabled in production unless this is set to true.
SWAGGER_ENABLED=false

TELEGRAM_BOT_TOKEN=disabled
TELEGRAM_CHAT_ID=disabled

DISCOGS_KEY=disabled
DISCOGS_SECRET=disabled
